{
	frankenphp {
		num_threads 2
	}
	order php_server before file_server
}

http://:8000 {
	root * /fleetbase/api/public
	encode zstd br gzip
	header X-Content-Type-Options "nosniff"
	header X-Frame-Options "DENY"
	header Referrer-Policy "strict-origin-when-cross-origin"
	php_server {
		resolve_root_symlink
	}
}
